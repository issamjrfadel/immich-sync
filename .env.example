# Immich Multi-Sync Hub Environment Configuration
# Copy this file to `.env` (or `/mnt/user/appdata/immich-sync/.env` on Unraid)
# to set container variables (TZ, DASHBOARD_PASSWORD, AUTO_DAEMON) and
# bootstrap initial sync settings when `config.json` does not exist yet.
# Once `config.json` exists, changes saved in the Web UI always win unless
# you explicitly set ENV_OVERRIDE=true below.

# --- Container & Web UI ---
TZ=America/Toronto
PORT=5050
AUTO_DAEMON=true
DASHBOARD_USER=admin
# Set a strong password to protect both the Web UI and noVNC with authentication
DASHBOARD_PASSWORD=
# Set ENV_OVERRIDE=true only if you want .env values to overwrite config.json on every reload
# ENV_OVERRIDE=false

# --- Immich (Master Source) ---
# Example: IMMICH_URL=http://192.168.1.100:2283
IMMICH_URL=
IMMICH_API_KEY=
# IMMICH_VERIFY_SSL=true
# IMMICH_ENABLED=true

# --- iCloud Photos ---
ICLOUD_APPLE_ID=
ICLOUD_PASSWORD=
# ICLOUD_UPLOAD_VIDEOS=true
# ICLOUD_ENABLED=true

# --- Amazon Photos ---
# Leave blank if signing in via Web UI / noVNC or 1-Click Bookmarklet
# Example TLD: 'ca' (amazon.ca), 'com' (amazon.com), 'co.uk', 'de'
# AMAZON_TLD=ca
AMAZON_SESSION_ID=
AMAZON_UBID=
AMAZON_AT_TOKEN=
# AMAZON_UPLOAD_VIDEOS=false
# AMAZON_ENABLED=true

# --- Sync Behavior (uncomment only if overriding Web UI settings) ---
# POLL_INTERVAL_SECONDS=300
# MAX_DELETE_LIMIT=50
# SYNC_DELETIONS=true
# SYNC_ALBUMS=true
# IGNORE_HIDDEN_AND_LOCKED=true
# DRY_RUN=false

# --- Notifications (Apprise / Telegram Daily Scan Summary) ---
# Use Apprise URL format (e.g. tgram://BOT_TOKEN/CHAT_ID) or set TELEGRAM_* below
APPRISE_URLS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# NOTIFICATIONS_ENABLED=true
# Local hour (0-23, respects TZ) when daily statistics summary is sent
# DAILY_SUMMARY_HOUR=21
# NOTIFY_ON_ERROR=false
