# Immich Multi-Sync Hub Environment Configuration
# Copy this file to `.env` (or `/mnt/user/appdata/immich-sync/.env` on Unraid)
# and fill in your values. Never commit `.env` with real secrets to Git!

# --- Container & Web UI ---
TZ=America/Toronto
PORT=5050
AUTO_DAEMON=true
DASHBOARD_USER=admin
# Set a strong password to protect the Web UI with HTTP Basic Auth
DASHBOARD_PASSWORD=

# --- Immich (Master Source) ---
IMMICH_URL=http://192.168.1.100:2283
IMMICH_API_KEY=
IMMICH_VERIFY_SSL=true
IMMICH_ENABLED=true

# --- iCloud Photos ---
ICLOUD_APPLE_ID=
ICLOUD_PASSWORD=
ICLOUD_UPLOAD_VIDEOS=true
ICLOUD_ENABLED=true

# --- Amazon Photos ---
# Use 'ca' for amazon.ca, 'com' for amazon.com, 'co.uk' for amazon.co.uk, etc.
AMAZON_TLD=ca
AMAZON_SESSION_ID=
# For amazon.ca these map to ubid-acbca and at-acbca (or ubid-main/at-main for amazon.com)
AMAZON_UBID=
AMAZON_AT_TOKEN=
AMAZON_UPLOAD_VIDEOS=false
AMAZON_ENABLED=true

# --- Sync Behavior ---
POLL_INTERVAL_SECONDS=300
MAX_DELETE_LIMIT=50
SYNC_DELETIONS=true
SYNC_ALBUMS=true
IGNORE_HIDDEN_AND_LOCKED=true
DRY_RUN=false
